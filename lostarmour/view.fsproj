<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <NoDefaultLaunchSettingsFile>True</NoDefaultLaunchSettingsFile>
    <PublishSingleFile>true</PublishSingleFile>
    <ApplicationIcon>favicon-32x32.ico</ApplicationIcon> 
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="view.fsx" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="xslt\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>  
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.FuncUI" Version="2.0.0" />
    <PackageReference Include="Avalonia.FuncUI.Elmish" Version="2.0.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="AvaloniaCommunity.FuncUI.Bindings.DataGrid" Version="12.0.0" />   
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />  
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" /> 
  </ItemGroup>
</Project>